{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lfhe:M07_INTELLIGENCE_ASSESSOR:1.0.0:output",
  "title": "M07_INTELLIGENCE_ASSESSOR output (global output envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "status",
    "result",
    "warnings",
    "human_review_required"
  ],
  "properties": {
    "module": {
      "const": "M07_INTELLIGENCE_ASSESSOR"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "SUCCESS_WITH_WARNINGS",
        "INSUFFICIENT_INFORMATION",
        "AMBIGUOUS",
        "FAILED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_confidence_rationale",
        "ai_recommended_confidence",
        "assessment_statements",
        "baseline_version_id",
        "derived_summary",
        "event_id",
        "event_version_id",
        "indicators_to_watch",
        "previous_assessment_version_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "baseline_version_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_assessment_version_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment_statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attribution_required",
              "attribution_text",
              "contradicting_claim_ids",
              "evidence_required",
              "likelihood",
              "premise_statement_local_ids",
              "provenance_class",
              "statement_local_id",
              "statement_text",
              "statement_type",
              "supporting_claim_ids",
              "supporting_reference_context_ids",
              "uses_baseline"
            ],
            "properties": {
              "statement_local_id": {
                "type": "string",
                "pattern": "^AS[0-9]{1,3}$"
              },
              "statement_type": {
                "enum": [
                  "KNOWN_FACT",
                  "ASSUMPTION",
                  "CHANGE_FROM_BASELINE",
                  "ANALYTIC_JUDGMENT",
                  "IMPLICATION",
                  "ALTERNATIVE_EXPLANATION",
                  "INFORMATION_GAP",
                  "INDICATOR_SUPPORT",
                  "INDICATOR_WEAKEN",
                  "HU_NATO_RELEVANCE"
                ]
              },
              "statement_text": {
                "type": "string",
                "minLength": 3,
                "maxLength": 4000
              },
              "provenance_class": {
                "enum": [
                  "CASE_EVIDENCE",
                  "APPROVED_REFERENCE_CONTEXT",
                  "MIXED",
                  "NONE_REQUIRED"
                ]
              },
              "supporting_claim_ids": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "contradicting_claim_ids": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "supporting_reference_context_ids": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "uses_baseline": {
                "type": "boolean"
              },
              "premise_statement_local_ids": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^AS[0-9]{1,3}$"
                }
              },
              "attribution_required": {
                "type": "boolean"
              },
              "attribution_text": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "evidence_required": {
                "type": "boolean"
              },
              "likelihood": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "term",
                      "rationale"
                    ],
                    "properties": {
                      "term": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{1,60}$"
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "derived_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "source_statement_ids"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 3000
            },
            "source_statement_ids": {
              "type": "array",
              "maxItems": 60,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^AS[0-9]{1,3}$"
              }
            }
          }
        },
        "indicators_to_watch": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "indicator_local_id",
              "indicator_text",
              "observable_condition",
              "related_statement_local_ids",
              "supporting_claim_ids"
            ],
            "properties": {
              "indicator_local_id": {
                "type": "string",
                "pattern": "^IND[0-9]{1,3}$"
              },
              "indicator_text": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1000
              },
              "observable_condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "related_statement_local_ids": {
                "type": "array",
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^AS[0-9]{1,3}$"
                }
              },
              "supporting_claim_ids": {
                "type": "array",
                "maxItems": 50,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        },
        "ai_recommended_confidence": {
          "enum": [
            "HIGH",
            "MODERATE",
            "LOW"
          ]
        },
        "ai_confidence_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}
