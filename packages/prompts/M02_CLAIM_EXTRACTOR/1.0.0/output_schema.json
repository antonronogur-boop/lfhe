{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lfhe:M02_CLAIM_EXTRACTOR:1.0.0:output",
  "title": "M02 Claim Extractor output (global output envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "status",
    "result",
    "warnings",
    "human_review_required"
  ],
  "properties": {
    "module": {
      "const": "M02_CLAIM_EXTRACTOR"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "SUCCESS_WITH_WARNINGS",
        "INSUFFICIENT_INFORMATION",
        "AMBIGUOUS",
        "FAILED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article_snapshot_id",
        "text_representation_id",
        "claims"
      ],
      "properties": {
        "article_snapshot_id": {
          "type": "string"
        },
        "text_representation_id": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_local_id",
              "claim_text_original",
              "claim_text_normalised",
              "claim_type",
              "source_statement_status",
              "attribution",
              "event_date",
              "event_date_confidence",
              "entities",
              "locations",
              "quantity",
              "unit",
              "evidence_type",
              "evidence_directness",
              "source_uncertainty_preserved",
              "potential_contradiction",
              "evidence_span_original",
              "normalisation_check",
              "human_review_required"
            ],
            "properties": {
              "claim_local_id": {
                "type": "string",
                "pattern": "^C[0-9]{1,3}$"
              },
              "claim_text_original": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "claim_text_normalised": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "claim_type": {
                "enum": [
                  "OBSERVATION",
                  "ANNOUNCEMENT",
                  "PROCUREMENT",
                  "DEPLOYMENT",
                  "OPERATION",
                  "LOSS",
                  "CAPABILITY",
                  "TEST",
                  "DELIVERY",
                  "PRODUCTION",
                  "TRAINING",
                  "POLICY",
                  "DOCTRINE",
                  "ORGANISATION",
                  "TECHNOLOGY",
                  "ASSESSMENT_BY_SOURCE",
                  "OTHER"
                ]
              },
              "source_statement_status": {
                "enum": [
                  "FACT_REPORTED_BY_SOURCE",
                  "SOURCE_ASSESSMENT",
                  "SOURCE_EXPECTATION",
                  "SOURCE_CLAIM_UNVERIFIED",
                  "DIRECT_OBSERVATION_REPORTED",
                  "UNKNOWN"
                ]
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "event_date": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
              },
              "event_date_confidence": {
                "enum": [
                  "HIGH",
                  "MODERATE",
                  "LOW",
                  "UNKNOWN"
                ]
              },
              "entities": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mention_text_original",
                    "entity_type"
                  ],
                  "properties": {
                    "mention_text_original": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "entity_type": {
                      "enum": [
                        "ORGANISATION",
                        "PERSON",
                        "COUNTRY",
                        "LOCATION",
                        "MILITARY_UNIT",
                        "SYSTEM",
                        "OTHER",
                        null
                      ]
                    }
                  }
                }
              },
              "locations": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "quantity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "evidence_type": {
                "enum": [
                  "OFFICIAL_STATEMENT",
                  "COMPANY_STATEMENT",
                  "MEDIA_REPORT",
                  "EXPERT_COMMENTARY",
                  "DOCUMENT_OR_DATA",
                  "IMAGERY_DESCRIPTION",
                  "OTHER",
                  "UNKNOWN"
                ]
              },
              "evidence_directness": {
                "enum": [
                  "DIRECT",
                  "INDIRECT",
                  "UNKNOWN"
                ]
              },
              "source_uncertainty_preserved": {
                "type": "boolean"
              },
              "potential_contradiction": {
                "type": "boolean"
              },
              "evidence_span_original": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exact_text",
                  "start",
                  "end",
                  "language"
                ],
                "properties": {
                  "exact_text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "start": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "end": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "language": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                  }
                }
              },
              "normalisation_check": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "actor",
                  "action",
                  "attribution",
                  "uncertainty",
                  "modality",
                  "quantity",
                  "unit",
                  "time",
                  "location",
                  "negation",
                  "conditionality",
                  "source_assessment_language",
                  "translation_material_mismatch",
                  "source_language_interpretation_uncertain"
                ],
                "properties": {
                  "actor": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "action": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "attribution": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "uncertainty": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "modality": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "quantity": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "unit": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "time": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "location": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "negation": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "conditionality": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "source_assessment_language": {
                    "enum": [
                      "PRESERVED",
                      "NOT_PRESENT",
                      "CHANGED"
                    ]
                  },
                  "translation_material_mismatch": {
                    "type": "boolean"
                  },
                  "source_language_interpretation_uncertain": {
                    "type": "boolean"
                  }
                }
              },
              "human_review_required": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}
