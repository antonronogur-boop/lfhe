{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lfhe:M05_EVENT_BUILDER:1.0.0:output",
  "title": "M05_EVENT_BUILDER output (global output envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module",
    "status",
    "result",
    "warnings",
    "human_review_required"
  ],
  "properties": {
    "module": {
      "const": "M05_EVENT_BUILDER"
    },
    "status": {
      "enum": [
        "SUCCESS",
        "SUCCESS_WITH_WARNINGS",
        "INSUFFICIENT_INFORMATION",
        "AMBIGUOUS",
        "FAILED",
        "HUMAN_REVIEW_REQUIRED"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposals"
      ],
      "properties": {
        "proposals": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposal",
              "target_event_id",
              "target_event_version_id",
              "related_event_ids",
              "claim_ids",
              "event_candidate",
              "reason",
              "confidence"
            ],
            "properties": {
              "proposal": {
                "enum": [
                  "CREATE_NEW_EVENT",
                  "UPDATE_EXISTING_EVENT",
                  "SUGGEST_MERGE",
                  "SUGGEST_SPLIT",
                  "SUGGEST_SUPERSEDE",
                  "KEEP_SEPARATE",
                  "INSUFFICIENT_INFORMATION",
                  "HUMAN_REVIEW_REQUIRED"
                ]
              },
              "target_event_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "target_event_version_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "related_event_ids": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "claim_ids": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "event_candidate": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "title",
                  "description",
                  "event_type",
                  "event_date_start",
                  "event_date_end",
                  "event_date_confidence",
                  "locations",
                  "claims"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 300
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  "event_type": {
                    "enum": [
                      "OBSERVATION",
                      "ANNOUNCEMENT",
                      "PROCUREMENT",
                      "DEPLOYMENT",
                      "OPERATION",
                      "LOSS",
                      "CAPABILITY",
                      "TEST",
                      "DELIVERY",
                      "PRODUCTION",
                      "TRAINING",
                      "POLICY",
                      "DOCTRINE",
                      "ORGANISATION",
                      "TECHNOLOGY",
                      "ASSESSMENT_BY_SOURCE",
                      "OTHER"
                    ]
                  },
                  "event_date_start": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
                  },
                  "event_date_end": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9]{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
                  },
                  "event_date_confidence": {
                    "enum": [
                      "HIGH",
                      "MODERATE",
                      "LOW",
                      "UNKNOWN"
                    ]
                  },
                  "locations": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "claims": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "claim_id",
                        "role"
                      ],
                      "properties": {
                        "claim_id": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                        },
                        "role": {
                          "enum": [
                            "SUPPORTS",
                            "CONTRADICTS",
                            "UPDATES",
                            "CONTEXTUALISES"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "confidence": {
                "enum": [
                  "HIGH",
                  "MODERATE",
                  "LOW"
                ]
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "human_review_required": {
      "type": "boolean"
    }
  }
}
