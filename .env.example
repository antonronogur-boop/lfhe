# LFHÉ environment template — copy to .env (git-ignored) and fill in.
# NEVER commit real values. Production secrets live in the deployment
# platform's secret manager, not in files.

# One of: DEV | TEST | PROD
LFHE_ENV=DEV

# Worker database connection. Must use a login role that is a member of
# lfhe_worker — NOT the Supabase service_role and NOT the postgres owner.
LFHE_DATABASE_URL=postgresql://lfhe_worker_login:CHANGE_ME@localhost:5432/lfhe_dev

# Object storage: LOCAL (DEV/TEST only) or S3 (Supabase Storage S3 protocol)
LFHE_STORAGE_BACKEND=LOCAL
LFHE_STORAGE_LOCAL_ROOT=./.local/storage
# LFHE_STORAGE_S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# LFHE_STORAGE_S3_BUCKET=lfhe-dev-snapshots
# LFHE_STORAGE_S3_REGION=eu-central-1
# LFHE_STORAGE_S3_ACCESS_KEY_ID=
# LFHE_STORAGE_S3_SECRET_ACCESS_KEY=

# Collector identity and politeness
LFHE_COLLECTOR_USER_AGENT=LFHE-OSINT-Collector/0.1 (+contact: set-me)
LFHE_COLLECTOR_MIN_INTERVAL_SECONDS=5
LFHE_COLLECTOR_MAX_BYTES=10485760
LFHE_COLLECTOR_TIMEOUT_SECONDS=30

# Web app (apps/web) — public anon key only; never the service_role key
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider (Phase 2) -------------------------------------------------
# Injected by the platform secret manager at runtime. NEVER commit a real key,
# never store it in the database, a prompt or a model configuration.
LFHE_ANTHROPIC_API_KEY=
